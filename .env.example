# ─── Port d'écoute sur le VPS (vérifier qu'il est libre : ss -tlnp) ───
# Si tu le changes, change aussi proxy_pass dans /etc/nginx/sites-available/fleurs-gourmandes54.fr
APP_PORT=3003

# ─── Base de données (PostgreSQL du VPS) ───
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@localhost:5432/NOM_BASE?schema=public"

# ─── Auth.js (générer avec : openssl rand -base64 32) ───
AUTH_SECRET="a-generer"
AUTH_URL="https://fleurs-gourmandes54.fr"
AUTH_TRUST_HOST=true

# ─── Emails (Resend) ───
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Domaine à vérifier dans Resend avant de l'utiliser ici
RESEND_FROM_EMAIL="Fleurs Gourmandes 54 <contact@fleurs-gourmandes54.fr>"
ADMIN_EMAIL="contact@fleurs-gourmandes54.fr"
